language ESSENCE' 1.0

given n: int(1..)
letting bound be 2 ** n
find Ticks_Explicit: matrix indexed by [int(1..n)] of int(0..bound)
branching on [Ticks_Explicit]
minimising Ticks_Explicit[n]
such that
    or([Ticks_Explicit[q13] = 0 | q13 : int(1..n)]),
    and([and([and([!(Ticks_Explicit[q8] = Ticks_Explicit[q10] \/ Ticks_Explicit[q9] = Ticks_Explicit[q10]) \/
                   !(Ticks_Explicit[q8] = Ticks_Explicit[q11] \/ Ticks_Explicit[q9] = Ticks_Explicit[q11])
                   \/
                   (!(Ticks_Explicit[q10] = Ticks_Explicit[q8] \/ Ticks_Explicit[q11] = Ticks_Explicit[q8]) \/
                    !(Ticks_Explicit[q10] = Ticks_Explicit[q9] \/ Ticks_Explicit[q11] = Ticks_Explicit[q9])),
                   allDiff([Ticks_Explicit[q10], Ticks_Explicit[q11]; int(1..2)]),
                   allDiff([Ticks_Explicit[q8], Ticks_Explicit[q9]; int(1..2)]);
                       int(1..3)])
              -> Ticks_Explicit[q10] - Ticks_Explicit[q11] != Ticks_Explicit[q8] - Ticks_Explicit[q9]
                  | q8 : int(1..n), q9 : int(1..n), q9 > q8])
             | q10 : int(1..n), q11 : int(1..n), q11 > q10]),
    and([Ticks_Explicit[q1] < Ticks_Explicit[q1 + 1] | q1 : int(1..n - 1)])

